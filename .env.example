# LLM API Keys (OpenAI / Google Gemini)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Next.js Port (Default: 3000)
PORT=3000

# Vercel Services Internal Binding
# (Injected automatically by Vercel services when using service binding to "backend")
# BACKEND_URL=https://...
